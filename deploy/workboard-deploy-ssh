#!/usr/bin/python3 -I
import os
import re
import subprocess
import sys


command = os.environ.get("SSH_ORIGINAL_COMMAND", "")
if command == "check":
    print("Workboard deployment connection ready")
elif re.fullmatch(r"deploy [0-9a-f]{40}-[0-9]+-[0-9]+ [0-9a-f]{64}", command):
    sys.exit(subprocess.call(["/usr/bin/sudo", "-n", "/usr/local/sbin/workboard-deploy", *command.split()[1:]]))
else:
    print("Only check and deploy commands are permitted", file=sys.stderr)
    sys.exit(1)
